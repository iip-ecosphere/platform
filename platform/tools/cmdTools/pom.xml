<?xml version="1.0" encoding="UTF-8" standalone="no"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>cmdTools</artifactId>
  <packaging>jar</packaging>
  <name>Command tools</name>
  <description>Command utility tools.</description>

  <parent>
     <groupId>de.iip-ecosphere.platform</groupId>
     <artifactId>platformDependencies</artifactId>
     <version>0.8.2-SNAPSHOT</version>
     <relativePath/>
  </parent>

  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
    <java.encoding>Cp1252</java.encoding>
    <jenkins.html.file>test.html</jenkins.html.file>
    <workspace.basedir>${project.basedir}/../..</workspace.basedir>
    <repo.basedir>${settings.localRepository}</repo.basedir>
    <minVer>0.2.0</minVer>
    <maxVer>${project.version}</maxVer>
    <includingMaxVer>false</includingMaxVer>
    <includingReleases>true</includingReleases>
    <simulate>false</simulate>
    
    <oldParentPOMVersion>${project.version}</oldParentPOMVersion>
    <newParentPOMVersion></newParentPOMVersion>
    <oldPOMVersion>${project.version}</oldPOMVersion>
    <newPOMVersion></newPOMVersion>
    
  </properties>
  
  <dependencies>
  
    <!-- as this is tooling outside oktoflow, we can use usual dependencies here -->
  
    <dependency>
        <artifactId>support</artifactId>
        <groupId>de.iip-ecosphere.platform</groupId>
        <version>${project.version}</version>
    </dependency>    
    <dependency>
        <artifactId>support.commons-apache</artifactId>
        <groupId>de.iip-ecosphere.platform</groupId>
        <version>${project.version}</version>
    </dependency>    
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.17.2</version>
    </dependency>
    <dependency>
       <groupId>com.fasterxml.jackson.core</groupId>
       <artifactId>jackson-databind</artifactId>
       <version>${com.fasterxml.jackson.version}</version>
    </dependency>    
    <dependency> <!-- preliminary -->
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>4.0.0</version>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  
  <build>
    <plugins>
       <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${org.codehaus.mojo.exec-maven-plugin.version}</version>
          <executions>
              <execution>
                 <id>cleanTemp</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.CleanTemp</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                 </configuration>
              </execution>
              <execution>
                 <id>jenkinsHtmlParser</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.JenkinsHtmlParser</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                     <arguments>
                         <argument>${jenkins.html.file}</argument>
                     </arguments>
                 </configuration>
              </execution>
              <execution>
                 <id>cleanDumps</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.CleanDumps</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                     <arguments>
                         <argument>${workspace.basedir}</argument>
                     </arguments>
                 </configuration>
              </execution>
              <execution>
                 <id>cleanDumps</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.CleanMvnSnapshots</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                 </configuration>
              </execution>
              <execution>
                 <id>cleanMvnSnapshots</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.CleanMvnSnapshots</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                 </configuration>
              </execution>
              <execution>
                 <id>cleanMvnArtifactsWorkspace</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.CleanMvnArtifacts</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                     <arguments>
                         <argument>${workspace.basedir}</argument>
                         <argument>--minVer=${minVer}</argument>
                         <argument>--maxVer=${maxVer}</argument>
                         <argument>--includingMaxVer=${includingMaxVer}</argument>
                         <argument>--releases=${includingReleases}</argument>
                         <argument>--simulate=${simulate}</argument>
                     </arguments>
                 </configuration>
              </execution>
              <execution>
                 <id>cleanMvnArtifactsRepo</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.CleanMvnArtifacts</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                     <arguments>
                         <argument>${repo.basedir}</argument>
                         <argument>--minVer=${minVer}</argument>
                         <argument>--maxVer=${maxVer}</argument>
                         <argument>--includingMaxVer=${includingMaxVer}</argument>
                         <argument>--releases=${includingReleases}</argument>
                         <argument>--simulate=${simulate}</argument>
                     </arguments>
                 </configuration>
              </execution>
              <execution>
                 <id>changePomVersion</id>
                 <configuration>
                     <mainClass>de.oktoflow.platform.cmdTools.ChangePomVersion</mainClass>
                     <cleanupDaemonThreads>false</cleanupDaemonThreads>
                     <arguments>
                         <argument>${workspace.basedir}</argument>
                         <argument>--oldParentPOMVersion=${oldParentPOMVersion}</argument>
                         <argument>--newParentPOMVersion=${newParentPOMVersion}</argument>
                         <argument>--oldPOMVersion=${oldPOMVersion}</argument>
                         <argument>--newPOMVersion=${newPOMVersion}</argument>
                         <argument>--properties=iip.version</argument>
                         <argument>--excludes=.*[/,\\]target[/,\\].*</argument>
                         <argument>--simulate ${simulate}</argument>
                     </arguments>
                 </configuration>
              </execution>
          </executions>
        </plugin>    
    </plugins>
  </build>
  
</project>