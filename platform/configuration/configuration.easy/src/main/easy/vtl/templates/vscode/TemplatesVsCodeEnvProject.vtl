@advice(IIPEcosphere)
@indent(indentation = 4, additional = 0)
template TemplatesVsCodeEnvProject(IIPEcosphere config, FileArtifact target) {
	
    def main(IIPEcosphere config, FileArtifact target) {
        // initial, focuses on workspace root not project, unclear; no input
        String sep = target.getPathSeparator();
        '{
            "python.analysis.extraPaths": [
                "\\${workspaceFolder}/target/pyEnv/iip",
                "\\${workspaceFolder}/target/pySrc"
            ],
            "terminal.integrated.env.windows": {
                "PYTHONPATH": "\\${workspaceFolder}/target/pyEnv/iip;\\${workspaceFolder}/target/pySrc"
            },
            "terminal.integrated.env.osx": {
                "PYTHONPATH": "\\${workspaceFolder}/target/pyEnv/iip:\\${workspaceFolder}/target/pySrc"
            },
            "terminal.integrated.env.linux": {
                "PYTHONPATH": "\\${workspaceFolder}/target/pyEnv/iip:\\${workspaceFolder}/target/pySrc"
            }
        }'
    }
    
/*
 
{
    // Verhindert gelbe/rote Schlangenlinien im Editor (plattformunabhängig)
