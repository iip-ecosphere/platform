project ApplicationPartMyApp {

    import ServiceMeshPart*;

    annotate BindingTime bindingTime = BindingTime::compile to .;
    
    Application myApp = {
        id = "SimpleMeshApp",
        name = "Simple Mesh Testing App",
        ver = "0.1.0",
        description = "",
        services = {refBy(myMesh)},
        displayRows = {refBy(mainRow)}
    };
    
    DeploymentPlan testDeploymentPlan = {
        name = "TestPlan (all local)", 
        application = refBy(myApp), 
        id = "TestPlan_all_local", 
        description = "Default deployment plan with all services running local.", 
        assignments = {
            NamedServiceAssignment {
                resource = "local", 
                services = {
                    refBy(node_Simple_Data_Receiver), refBy(node_Simple_Data_Source)
                }
            }
        }, 
        ensembles = {}
    };    
    
    freeze {
        .;
    }

}
