project ApplicationPartPythonApp {

    import ServiceMeshPartPythonApp*;

    annotate BindingTime bindingTime = BindingTime::compile to .;
    
    Application myPythonApp = {
        id = "PythonApp",
        name = "Simple Python demo flow app",
        ver = "0.1.0",
        description = "",
        services = {refBy(myPythonMesh)}        
    };
    
    DeploymentPlan pythonDeploymentPlan = {
        name = "Python Deployment Plan (all local)", 
        application = refBy(myPythonApp), 
        id = "PythonPlan_all_local", 
        description = "Python deployment plan with all services running local.", 
        assignments = {
            NamedServiceAssignment {
                resource = "local", 
                services = {
                    refBy(myPythonReceiver), refBy(myPythonTransformer), refBy(myPythonSource)
                }
            }
        }, 
        ensembles = {}
    };
    
    freeze {
        .;
    }

}
